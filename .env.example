# SignBridge Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# Application Settings
# ============================================
APP_NAME=SignBridge
APP_ENV=development  # development, staging, production
DEBUG=True
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# ============================================
# API Configuration
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True
API_WORKERS=4

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_CREDENTIALS=True
CORS_METHODS=*
CORS_HEADERS=*

# ============================================
# Database Configuration
# ============================================
# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/signbridge
DB_HOST=localhost
DB_PORT=5432
DB_NAME=signbridge
DB_USER=signbridge_user
DB_PASSWORD=your_secure_password_here

# Database Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ============================================
# Redis Configuration
# ============================================
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Cache Settings
CACHE_TTL=300  # seconds (5 minutes)
CACHE_MAX_SIZE=1000

# ============================================
# Celery Configuration
# ============================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_EAGER_PROPAGATES=True

# ============================================
# Machine Learning Models
# ============================================
# Model Paths
MODEL_CHECKPOINT_DIR=models/checkpoints
SIGN_RECOGNITION_MODEL=models/checkpoints/sign_recognition_v1.ckpt
SIGN_GENERATION_MODEL=models/checkpoints/sign_generation_v1.ckpt

# Inference Settings
ML_BATCH_SIZE=32
ML_MAX_SEQUENCE_LENGTH=150
ML_DEVICE=cuda  # cuda or cpu
ML_NUM_WORKERS=4
ML_USE_FP16=True

# Model Cache
MODEL_CACHE_ENABLED=True
MODEL_WARMUP=True

# ============================================
# MediaPipe Configuration
# ============================================
MEDIAPIPE_MODEL_COMPLEXITY=2  # 0, 1, or 2
MEDIAPIPE_MIN_DETECTION_CONFIDENCE=0.5
MEDIAPIPE_MIN_TRACKING_CONFIDENCE=0.5
MEDIAPIPE_STATIC_IMAGE_MODE=False

# ============================================
# File Storage
# ============================================
# Local Storage
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=104857600  # 100MB in bytes
ALLOWED_VIDEO_EXTENSIONS=.mp4,.avi,.mov,.mkv
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png

# AWS S3 (Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=signbridge-data
S3_VIDEO_PREFIX=videos/
S3_MODEL_PREFIX=models/

# ============================================
# Authentication & Security
# ============================================
# JWT Settings
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password Settings
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=True
PASSWORD_REQUIRE_NUMBERS=True
PASSWORD_REQUIRE_SPECIAL=True

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# API Keys
API_KEY_HEADER=X-API-Key
API_KEY=your-api-key-here

# ============================================
# External Services
# ============================================
# Sentry (Error Tracking)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Google Analytics
GA_TRACKING_ID=

# Email (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@signbridge.com

# ============================================
# Feature Flags
# ============================================
ENABLE_SIGN_TO_TEXT=True
ENABLE_TEXT_TO_SIGN=True
ENABLE_LEARNING_MODE=True
ENABLE_MULTI_LANGUAGE=True
ENABLE_ON_DEVICE_INFERENCE=False

# Sign Languages Enabled
LANGUAGES_ENABLED=ASL,ISL,BSL,JSL,LSF,GSL

# ============================================
# Frontend Configuration
# ============================================
FRONTEND_URL=http://localhost:3000
WEBSOCKET_URL=ws://localhost:8000/ws

# ============================================
# Monitoring & Logging
# ============================================
# Prometheus
PROMETHEUS_ENABLED=True
PROMETHEUS_PORT=9090

# Logging
LOG_FILE=logs/signbridge.log
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=5
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ============================================
# Development Settings
# ============================================
# Debug Tools
ENABLE_DEBUG_TOOLBAR=False
ENABLE_PROFILING=False

# Database
DB_ECHO_SQL=False  # Log all SQL queries

# Testing
TEST_DATABASE_URL=postgresql://test_user:test_pass@localhost:5432/signbridge_test

# ============================================
# Docker Settings (for docker-compose)
# ============================================
COMPOSE_PROJECT_NAME=signbridge
DOCKER_REGISTRY=
DOCKER_IMAGE_TAG=latest

# ============================================
# Advanced Settings
# ============================================
# Timezone
TZ=UTC

# Max concurrent requests
MAX_CONCURRENT_REQUESTS=100

# Request timeout (seconds)
REQUEST_TIMEOUT=300

# Graceful shutdown timeout (seconds)
SHUTDOWN_TIMEOUT=60
