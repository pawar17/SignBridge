# SignBridge Environment Variables
# Copy this file to .env and fill in your values

# ── ElevenLabs TTS (Sign-to-Speech) ────────────────────────────────
# Get a free key at https://elevenlabs.io  (10,000 chars/month free)
# Alternatively, paste the key directly in the UI (ElevenLabs button, top-right)
ELEVENLABS_API_KEY=sk_your_key_here

# ── Server ──────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
